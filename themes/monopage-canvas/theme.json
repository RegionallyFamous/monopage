{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "ink",
					"color": "#111318",
					"name": "Ink"
				},
				{
					"slug": "paper",
					"color": "#f8f7f2",
					"name": "Paper"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "night",
					"color": "#050910",
					"name": "Night"
				},
				{
					"slug": "blue",
					"color": "#2868ff",
					"name": "Blue"
				},
				{
					"slug": "green",
					"color": "#19a974",
					"name": "Green"
				},
				{
					"slug": "teal",
					"color": "#0d9488",
					"name": "Teal"
				},
				{
					"slug": "coral",
					"color": "#ff6b5f",
					"name": "Coral"
				},
				{
					"slug": "lime",
					"color": "#c8df4a",
					"name": "Lime"
				},
				{
					"slug": "mist",
					"color": "#eaf6f4",
					"name": "Mist"
				},
				{
					"slug": "wash",
					"color": "#f8fafc",
					"name": "Wash"
				},
				{
					"slug": "glow",
					"color": "#f4f7ff",
					"name": "Glow"
				},
				{
					"slug": "line",
					"color": "#dfe3e8",
					"name": "Line"
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1160px"
		},
		"spacing": {
			"spacingScale": {
				"operator": "*",
				"increment": 1.5,
				"steps": 6,
				"mediumStep": 1.5,
				"unit": "rem"
			},
			"units": [
				"px",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "system-sans",
					"name": "System Sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				},
				{
					"slug": "system-serif",
					"name": "System Serif",
					"fontFamily": "Georgia, \"Times New Roman\", serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "2.25rem",
					"name": "Extra Large"
				},
				{
					"slug": "section-title",
					"size": "3rem",
					"name": "Section Title"
				},
				{
					"slug": "xx-large",
					"size": "4rem",
					"name": "2X Large"
				},
				{
					"slug": "hero",
					"size": "4.8rem",
					"name": "Hero"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"right": "1.25rem",
				"left": "1.25rem"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "6px"
				},
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--paper)"
				},
				"spacing": {
					"padding": {
						"top": "0.7rem",
						"right": "1rem",
						"bottom": "0.7rem",
						"left": "1rem"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "750",
					"lineHeight": "1.05"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--blue)"
				}
			}
		},
		"blocks": {
			"core/button": {
				"typography": {
					"fontWeight": "750"
				}
			},
			"core/navigation": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--ink)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"spacing": {
					"blockGap": "1rem"
				},
				"typography": {
					"fontSize": "0.95rem",
					"fontWeight": "700"
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "1.2rem",
					"fontWeight": "800"
				}
			}
		}
	}
}
