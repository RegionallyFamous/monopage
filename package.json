{
  "name": "monopage",
  "version": "0.2.35",
  "private": true,
  "description": "Monopage plugin, canvas theme, and Codex deployment skill.",
  "scripts": {
    "lint:php": "find plugins/monopage themes/monopage-canvas -name '*.php' -print0 | xargs -0 -n1 php -l",
    "check:js": "node scripts/check-js-syntax.mjs",
    "check:json": "node scripts/validate-json.mjs",
    "check:canvas": "node scripts/check-canvas-theme.mjs",
    "check:changed": "node scripts/changed-checks.mjs",
    "check:changed:run": "node scripts/changed-checks.mjs --run",
    "check:deploy": "node scripts/check-deploy-plan.mjs",
    "check:docs": "node scripts/check-doc-commands.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "check:links": "node scripts/check-template-links.mjs",
    "check:scripts": "node scripts/check-package-scripts.mjs",
    "check:playground": "node scripts/check-playground.mjs",
    "check:skill": "node scripts/check-skill.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "doctor": "node scripts/doctor.mjs",
    "package": "node scripts/package.mjs",
    "package:dry-run": "node scripts/package.mjs --dry-run",
    "package:verify": "node scripts/check-package-contents.mjs",
    "ci": "npm test && npm run package && npm run package:verify",
    "playground:url": "node scripts/playground-url.mjs",
    "deploy:dry-run": "node scripts/deploy-monopage.mjs --dry-run",
    "plugin:check": "node scripts/plugin-check.mjs --wp-env",
    "plugin:check:runtime": "node scripts/plugin-check.mjs --wp-env --runtime",
    "plugin:check:dry-run": "node scripts/plugin-check.mjs --wp-env --runtime --dry-run",
    "release:check": "node scripts/release-check.mjs",
    "release:check:dry-run": "node scripts/release-check.mjs --dry-run",
    "skill:install": "node scripts/install-skill.mjs --unlink-legacy",
    "skill:install:dry-run": "node scripts/install-skill.mjs --dry-run --unlink-legacy",
    "version:set": "node scripts/set-version.mjs",
    "local:start": "wp-env start",
    "local:stop": "wp-env stop",
    "local:review": "node scripts/local-review.mjs",
    "local:review:dry-run": "node scripts/local-review.mjs --dry-run",
    "local:ready": "node scripts/local-ready.mjs",
    "local:setup": "node scripts/local-setup.mjs",
    "local:refresh-template": "node scripts/local-setup.mjs --force-template",
    "local:smoke": "node scripts/homepage-smoke.mjs",
    "local:capture": "node scripts/capture-homepage.mjs",
    "local:capture:dry-run": "node scripts/capture-homepage.mjs --dry-run",
    "local:admin-smoke": "node scripts/admin-smoke.mjs",
    "local:validate": "wp-env run cli wp monopage validate --require-focus",
    "local:status": "wp-env run cli wp monopage status",
    "test": "npm run lint:php && npm run check:js && npm run check:json && npm run check:canvas && npm run check:deploy && npm run check:docs && npm run check:hygiene && npm run check:links && npm run check:scripts && npm run check:playground && npm run check:skill && npm run check:versions && npm run package:dry-run"
  },
  "devDependencies": {
    "@wordpress/env": "^11.5.0"
  }
}
